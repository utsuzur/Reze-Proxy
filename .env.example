# Server Port
PORT=3000

# Environment (development or production)
NODE_ENV=development

# Admin Authentication
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH

# Database Configuration
# Options: sqlite (default) or postgres
DB_TYPE=sqlite

# Local SQLite Database Path (default: ./reze.db)
DB_PATH=./reze.db

# External PostgreSQL Connection String (required if DB_TYPE=postgres)
# Example: postgres://user:password@host:port/dbname
POSTGRES_URL=

# Database Synchronization (sync local and external DBs on startup)
# Options: true or false
DB_SYNC_ON_STARTUP=false

# Seeding (automatic creation of default providers and models on startup)
# Options: true or false (default: true)
SKIP_SEEDING=true
